# Host-specific configuration (each machine has its own)
config.yaml
config.lua

# Allow files
# (felix config removed - felix is no longer in the dotfiles module)

# Zsh compiled cache files (machine-generated, regenerate automatically)
*.zwc
.zcompdump
.zcompdump.*

# Auto-generated state files
state/
state/*.yaml
system-packages.yaml
state/installed.yaml
state/hooks-executed.yaml
modules/declared-packages.yaml

# Backup files
*.backup.*

# Temporary files
*.tmp
*.swp
*~

# Old JSON files (after YAML migration)
# Exclude package.json, settings.json and other needed configs
!dotfiles/**/settings.json
!**/package.json

# Large app caches - exclude from dotfiles
**/vesktop/sessionData/
**/vesktop/Cache*/
**/vesktop/GPUCache/
**/vesktop/Code Cache/
**/vesktop/Singleton*
**/zen/*/storage/
**/zen/*/cache*/
**/zen/*/Cache*/
**/zen/**/datareporting/
**/zen/**/crashes/
**/obsidian/**/cache/
**/obsidian/**/GPUCache/
